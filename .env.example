# Supabase（Dashboard → Settings → API Keys）
# URL: Settings → General，或 https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://hrearoyfuozkcrohsome.supabase.co

# 客户端 Key（二选一，不要用占位符！）：
# ① 新 Publishable key：sb_publishable_...（API Keys 页 default 那一行，点复制完整 key）
# ② Legacy anon key：API Keys → Legacy 标签 → anon → eyJhbGci...
VITE_SUPABASE_ANON_KEY=sb_publishable_替换为完整密钥

# DeepSeek API Key 仅配置在 Supabase Edge Function Secrets，不要写在此处
# supabase secrets set DEEPSEEK_API_KEY=sk-xxx
